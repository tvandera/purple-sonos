{
  "name": "Perl Dev Container",
  "build": {
    "dockerfile": "../docker/Dockerfile",
    "context": "..",
    "target": "development"
  },
  "runArgs": [
    "--network=host"
  ],
  "remoteUser": "vanderaa",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached"
  ]
}

